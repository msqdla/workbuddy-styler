{
  "name": "公众号样式排版工具",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {},
  "postCreateCommand": "pip3 install --user -r requirements.txt && python3 -m playwright install --with-deps chromium",
  "forwardPorts": [8777],
  "portsAttributes": {
    "8777": {
      "label": "排版工具",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "remoteUser": "vscode"
}
